---
import '../styles/global.css';
import '../styles/themes/editorial.css';
import '../styles/themes/original.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  current?: 'today' | 'archive' | 'search';
}

const {
  title = '前沿动态',
  description = '聚合论文、研究、开源与中文科技媒体的前沿动态，每天更新。',
  current,
} = Astro.props;

const fullTitle = title === '前沿动态' ? '前沿动态' : `${title} · 前沿动态`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        /* Keep in sync with THEMES in the module script below. */
        var THEMES = ['editorial', 'original'];
        var COLORS = {
          editorial: { light: '#ffffff', dark: '#141414' },
          original: { light: '#f3efe6', dark: '#131411' }
        };
        var root = document.documentElement;
        var theme = 'editorial';
        var mode = '';
        try {
          var legacy = localStorage.getItem('theme');
          if (legacy === 'light' || legacy === 'dark') {
            if (!localStorage.getItem('color-mode')) localStorage.setItem('color-mode', legacy);
            localStorage.removeItem('theme');
          }
          var savedTheme = localStorage.getItem('site-theme');
          if (THEMES.indexOf(savedTheme) !== -1) theme = savedTheme;
          var savedMode = localStorage.getItem('color-mode');
          if (savedMode === 'light' || savedMode === 'dark') mode = savedMode;
        } catch (e) {}
        root.dataset.theme = theme;
        if (mode) root.dataset.mode = mode;
        var resolved = mode || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta && COLORS[theme]) meta.setAttribute('content', COLORS[theme][resolved]);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到内容</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const THEMES = ['editorial', 'original'];
      const COLORS: Record<string, { light: string; dark: string }> = {
        editorial: { light: '#ffffff', dark: '#141414' },
        original: { light: '#f3efe6', dark: '#131411' },
      };
      const root = document.documentElement;
      const switcher = document.querySelector<HTMLElement>('.theme-switch');
      const modeToggle = document.querySelector<HTMLButtonElement>('#mode-toggle');
      const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
      const times = document.querySelectorAll<HTMLTimeElement>('time.rel-time');

      function currentMode() {
        const explicit = root.dataset.mode;
        if (explicit === 'light' || explicit === 'dark') return explicit;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function paintChrome(theme: string) {
        const meta = document.querySelector('meta[name="theme-color"]');
        const color = COLORS[theme]?.[currentMode()];
        if (meta && color) meta.setAttribute('content', color);
      }

      function applyTheme(theme: string) {
        if (!THEMES.includes(theme)) theme = 'editorial';
        root.dataset.theme = theme;
        for (const button of choices) {
          const selected = button.dataset.themeChoice === theme;
          button.setAttribute('aria-checked', selected ? 'true' : 'false');
          button.tabIndex = selected ? 0 : -1;
        }
        try {
          localStorage.setItem('site-theme', theme);
        } catch (e) {}
        paintChrome(theme);
      }

      for (const button of choices) {
        button.addEventListener('click', () => {
          applyTheme(button.dataset.themeChoice || 'editorial');
        });
      }

      switcher?.addEventListener('keydown', (event) => {
        const index = choices.findIndex((button) => button === document.activeElement);
        if (index < 0) return;
        let next = index;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % choices.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + choices.length) % choices.length;
        else return;
        event.preventDefault();
        applyTheme(choices[next].dataset.themeChoice || 'editorial');
        choices[next].focus();
      });

      applyTheme(root.dataset.theme || 'editorial');

      modeToggle?.addEventListener('click', () => {
        const next = currentMode() === 'dark' ? 'light' : 'dark';
        root.dataset.mode = next;
        try {
          localStorage.setItem('color-mode', next);
        } catch (e) {}
        paintChrome(root.dataset.theme || 'editorial');
      });

      function relative(iso: string) {
        const time = Date.parse(iso);
        if (Number.isNaN(time)) return '';
        const minutes = Math.round((Date.now() - time) / 60000);
        if (minutes < 1) return '刚刚';
        if (minutes < 60) return `${minutes} 分钟前`;
        const hours = Math.round(minutes / 60);
        if (hours < 24) return `${hours} 小时前`;
        const days = Math.round(hours / 24);
        if (days < 14) return `${days} 天前`;
        return '';
      }

      for (const node of times) {
        const label = relative(node.dateTime);
        if (label) node.textContent = label;
      }
    </script>
  </body>
</html>
