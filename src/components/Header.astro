---
interface Props {
  current?: 'today' | 'archive' | 'search';
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/">
      <span class="seal" data-themes="original" aria-hidden="true">沿</span>
      <span class="brand-text">
        <span class="brand-name">前沿动态</span>
        <span class="brand-sub">开发者的每日科技速递</span>
      </span>
    </a>
    <div class="header-actions">
      <nav aria-label="主导航">
        <a href="/" aria-current={current === 'today' ? 'page' : undefined}>今日</a>
        <a href="/archive/" aria-current={current === 'archive' ? 'page' : undefined}>归档</a>
        <a href="/search/" aria-current={current === 'search' ? 'page' : undefined}>检索</a>
      </nav>
      <div class="theme-switch" role="radiogroup" aria-label="版式">
        <button type="button" role="radio" data-theme-choice="editorial" aria-checked="true">报纸</button>
        <button type="button" role="radio" data-theme-choice="original" aria-checked="false" tabindex="-1">初版</button>
      </div>
      <button type="button" id="mode-toggle" aria-label="切换浅色或深色模式">
        <span class="when-light">深色</span>
        <span class="when-dark">浅色</span>
      </button>
    </div>
  </div>
</header>
